{
  peppy_schema: "contract/v1",
  manifest: {
    name: "camera_profile",
    tag: "v1",
    description: [
      "What a camera is and what it can do: the device it stands for, the encoding it publishes and the controls of its camera contract, plus a reset of those controls to the device defaults.",
      "A camera node implements this beside its rgb_camera or rgbd_camera contract so a caller can discover which controls to offer before calling one, with the modes, unit, bounds, device default and current value of each control, and can put the camera back in a known state. The camera contracts themselves carry the controls; this one only describes them, so a camera node that implements a camera contract alone is complete without it.",
    ],
  },
  interfaces: {
    services: [
      {
        name: "get_camera_profile",
        description: "Give the profile of the camera in profile_json. A camera that cannot describe itself, because it is not attached to its device or simulation yet, gives an error reply with `precondition_failed`.",
        response_message_format: {
          profile_json: {
            $type: "string",
            $description: "The profile as a JSON object: {\"device\": \"<device id>\", \"label\": \"<device name>\", \"encoding\": \"<wire encoding>\", \"reference\": {\"source\": \"<where the ranges come from>\", \"captured_on\": \"<YYYY-MM-DD>\"}, \"controls\": {...}}. controls is keyed by control name (\"exposure\", \"gain\", \"white_balance\", \"brightness\", \"contrast\"), each {\"supported\": <bool>} and, when supported, \"modes\" ([\"auto\", \"manual\"] or [\"manual\"]), \"unit\", \"min\", \"max\", \"default_mode\", \"default_value\", \"mode\" and \"value\" (the current ones; value is the effective reading in auto mode).",
          },
        },
      },
      {
        name: "reset_camera",
        description: "Put every control of the camera back to the device's defaults.",
      },
    ],
  },
}
