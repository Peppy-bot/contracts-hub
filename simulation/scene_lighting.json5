// The physical light sources of a simulated scene, edited while the
// simulation runs: discover what lights the scene has, read their effective
// values, set one property of one lamp, and restore the scene's authored
// lighting. Every value has a physical meaning and a unit, the same on every
// implementer, so a caller reasons about lux and lumens, never about a
// renderer's knobs. A change shows up in every view the engine renders,
// the robot's cameras included; it never recompiles the scene and never
// touches physics.
//
// Light ids are stable for the life of a loaded scene and come from
// get_lighting, which reports every light with its kind, the properties it
// supports (a point lamp has no cone), each property's unit and current
// value, and, for a light a caller can set, its authored default and its
// bounds. Kinds: "point" (a lamp: luminous flux in lumens, colour,
// position), "spot" (a lamp with a cone: flux, colour, position, direction,
// cone angles), "sun" and "moon" (directional lights: illuminance in lux,
// colour, direction), "sky" (the light of the whole sky: its illuminance on
// an open horizontal surface) and "environment" (a photographed environment
// map that gives the reflections of the room it was taken in: a radiance
// scale and an orientation). The sun, the moon and the sky follow the
// scene's daylight (scene_daylight): their values change with the date,
// the hour and the weather, and every setter refuses them.
//
// A scene can carry baked light, computed offline for each light at unit
// strength: for each lamp, the light it sends onto the scene's fixed
// surfaces after it bounces, for the lamp's authored position and
// direction; for the sun and the moon, their light after it bounces, for a
// set of directions across the part of the sky they cross at the scene's
// place, which a renderer blends for the direction they stand in; for the
// sky, its light directly and after it bounces, for each zone of the sky,
// which a renderer weighs by the light of that zone now. The direct light
// of the lamps, the sun and the moon stays live. A renderer that shows
// baked light lights the scene's fixed surfaces with it in the place of
// the environment map's diffuse light.
//
// Positions are world-frame metres, Z up; directions are unit vectors in
// the world frame, pointing the way the light travels; colours are linear
// RGB in the unit interval; cone angles are half angles in radians; the
// environment orientation is a unit quaternion [x, y, z, w] rotating the
// map into the world. A setter validates its whole request before it
// changes anything: it gives an error reply with `rejected` to a request
// for an unknown light, a light that follows the daylight, an unsupported
// property, or a value out of bounds or not finite, and the light stays as
// it was. The response of a setter gives the effective value after the
// call.
//
// Loading or clearing a scene through scene_manipulation restores that
// scene's authored lighting; reset_lighting does the same for the scene
// that is loaded, and a build of simulation_world starts from the authored
// lighting of its scene and sets the world's own lighting over it.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "scene_lighting",
    tag: "v2",
  },
  interfaces: {
    services: [
      {
        // Every light of the loaded scene, as a JSON object in
        // lighting_json: {"scene": "<scene asset id>", "lights": [...]}.
        // Each light carries "id", "kind", "label", "follows_daylight",
        // "baked_indirect" and "properties", an object keyed by property
        // name ("illuminance_lux", "luminous_flux_lm", "radiance_scale",
        // "color_rgb", "position_m", "direction", "inner_angle_rad",
        // "outer_angle_rad", "orientation_xyzw"), each with "unit" and
        // "value" and, for a light that does not follow the daylight,
        // "default" and, for scalars, "min" and "max". "baked_indirect" is
        // "on" while the light's baked light matches the scene; "none" when
        // the scene has no baked light for the light (the environment map
        // never has); "off_light_moved" while a lamp's position or
        // direction differs from the one its baked light was computed for
        // (reset_lighting or setting it back turns it on, and so does a
        // build of simulation_world whose world moves and removes none of
        // the objects that the baked light covers and does not move the
        // lamp); "off_scene_changed", whatever the lighting, after an object
        // of the scene that the baked light covers was moved or removed,
        // until load_scene loads a scene or a build of simulation_world
        // builds a world that moves and removes none of those objects. A
        // light lists only the properties it supports. An engine that has
        // no lighting to report, because no
        // scene is loaded yet, gives an error reply with
        // `precondition_failed`.
        name: "get_lighting",
        response_message_format: {
          lighting_json: "string",
        },
      },
      {
        // The light's strength: luminous flux in lumens for a point or spot
        // lamp, the radiance scale of an environment map (the map's stored
        // radiance times this scale is cd/m2). Finite, nonnegative, at most
        // the light's reported max.
        name: "set_light_intensity",
        request_message_format: {
          light_id: "string",
          value: "f64",
        },
        response_message_format: {
          current_value: "f64",
        },
      },
      {
        // A lamp's colour, linear RGB in the unit interval. Not supported by
        // an environment light, whose colour is its map.
        name: "set_light_color",
        request_message_format: {
          light_id: "string",
          color: { $type: "array", $items: "f64", $length: 3 },
        },
        response_message_format: {
          current_color: { $type: "array", $items: "f64", $length: 3 },
        },
      },
      {
        // Where a point or spot lamp sits, world-frame metres.
        name: "set_light_position",
        request_message_format: {
          light_id: "string",
          position: { $type: "array", $items: "f64", $length: 3 },
        },
        response_message_format: {
          current_position: { $type: "array", $items: "f64", $length: 3 },
        },
      },
      {
        // Which way a spot lamp shines: a world-frame vector, normalised by
        // the implementer. A vector with no length gets an error reply with
        // `rejected`.
        name: "set_light_direction",
        request_message_format: {
          light_id: "string",
          direction: { $type: "array", $items: "f64", $length: 3 },
        },
        response_message_format: {
          current_direction: { $type: "array", $items: "f64", $length: 3 },
        },
      },
      {
        // A spot lamp's cone, half angles in radians: full intensity inside
        // inner_angle, none beyond outer_angle, with
        // 0 <= inner_angle < outer_angle < pi/2.
        name: "set_light_cone",
        request_message_format: {
          light_id: "string",
          inner_angle: "f64",
          outer_angle: "f64",
        },
        response_message_format: {
          current_inner_angle: "f64",
          current_outer_angle: "f64",
        },
      },
      {
        // The environment map's orientation, a unit quaternion [x, y, z, w]
        // rotating the map into the world frame.
        name: "set_light_orientation",
        request_message_format: {
          light_id: "string",
          orientation: { $type: "array", $items: "f64", $length: 4 },
        },
        response_message_format: {
          current_orientation: { $type: "array", $items: "f64", $length: 4 },
        },
      },
      {
        // Every lamp and the environment map back to the loaded scene's
        // authored values. The daylight stays: reset_daylight of
        // scene_daylight restores it.
        name: "reset_lighting",
      },
    ],
  },
}
