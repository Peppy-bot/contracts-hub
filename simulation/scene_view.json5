// A picture of the simulated world from a free viewpoint, for a caller that
// sets the world up and looks at what it built from wherever it likes. Only
// a simulation can give it: no robot sees this picture, and the cameras a
// robot carries publish through the camera contracts. A view is rendered on
// request from the world as it stands at that instant, with the lighting
// and materials the scene renders under.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "scene_view",
    tag: "v1",
  },
  interfaces: {
    services: [
      {
        // Renders the world as seen from `position`, looking at `target`,
        // both world-frame points in metres, with +Z up in the picture. A
        // position equal to the target is refused. success false with the
        // reason in message is the answer of an engine that renders nothing;
        // its other fields are then zero or empty and mean nothing.
        name: "render_view",
        request_message_format: {
          // Where the viewpoint is: x, y, z (m).
          position: { $type: "array", $items: "f64", $length: 3 },
          // The point the view looks at: x, y, z (m).
          target: { $type: "array", $items: "f64", $length: 3 },
        },
        response_message_format: {
          success: "bool",
          message: "string",
          // The simulated instant the picture shows.
          timestamp: "time",
          // The pixel format of frame: "rgb8".
          encoding: "string",
          width: "u32",
          height: "u32",
          // The picture, width x height pixels, rows from the top, each
          // pixel three bytes.
          frame: { $type: "array", $items: "u8" },
        },
      },
    ],
  },
}
