// The ground truth of the objects a simulation engine spawned through
// scene_control: what each one is, where it is right now and how fast it
// moves. One record, read two ways from the same state: the stream
// (object_states) publishes the implementer's captures on its own state
// cadence, and get_object_states answers its latest capture on demand, for
// example to a scene commander that refreshes its list after an edit. That
// capture can be one the stream never carried: an implementer captures
// again when a scene edit completes. A consumer can judge a task from this
// (the cube came to rest in the tray) without holding a pairing. Object ids
// are the ones scene_control minted; a snapshot carries one record per
// spawned object, whatever its physics, and an empty list when nothing is
// spawned. Only spawned objects are listed, never the robot's links or the
// scene's backdrop.
//
// Every snapshot is complete: a dropped message needs no replay, the next
// one replaces it. A snapshot's timestamp is when the implementer captured
// it, never when it was requested or sent, on the same clock for both
// reads. An edit made while that clock stands still (simulated time between
// steps) is captured at the same instant as the snapshot before it.
//
// Ground truth is a debugging surface and stays inside the peppy
// framework: harness tests, recorders, scene commanders and the evaluation
// of a trained behaviour (did the cube end up in the tray) read it. No
// mcp_exposure/v1 document ever selects a member of this contract. An
// MCP endpoint is the one surface a model drives on the real robot and
// in simulation alike, and the real world has no ground truth to
// publish, so a resource or tool built on this contract would exist
// only in simulation and split the two. The mcp-hub's
// test_no_simulation_ground_truth.py refuses such a target.
//
// Poses are world frame: position in metres, orientation a unit
// quaternion [x, y, z, w]. Velocities are world axes, taken at the
// object's origin: linear in m/s, angular in rad/s. Static and
// visual-only objects report a fixed pose and zero velocities. Mass (kg)
// and scale are the ones the object was spawned with; only a dynamic
// object simulates its mass.
//
// What an object touches is not here: contact_state lists every contact
// the engine resolves, from both sides, naming a spawned object by the
// same object_id, so a consumer joins the two on that string.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "object_state",
    tag: "v1",
  },
  interfaces: {
    topics: [
      {
        name: "object_states",
        // High-frequency stream where only the latest snapshot matters;
        // occasional drops are acceptable.
        qos_profile: "sensor_data",
        message_format: {
          // Implementer-side capture time of this snapshot.
          timestamp: "time",
          // One record per spawned object, in the implementer's order.
          objects: {
            $type: "array",
            $items: {
              $type: "object",
              object_id: "string",
              // The asset it was spawned from.
              asset_id: "string",
              // "dynamic", "static" or "none", as spawned.
              physics: "string",
              mass: "f64",
              scale: "f64",
              position: { $type: "array", $items: "f64", $length: 3 },
              orientation: { $type: "array", $items: "f64", $length: 4 },
              linear_velocity: { $type: "array", $items: "f64", $length: 3 },
              angular_velocity: { $type: "array", $items: "f64", $length: 3 },
            },
          },
        },
      },
    ],
    services: [
      {
        // The latest capture, on demand, in the stream's records and from
        // the same state. Answered before the first streamed snapshot, and
        // once a scene_control goal has completed, the snapshot includes
        // its edit.
        name: "get_object_states",
        response_message_format: {
          // False when the implementer has no object state to report (it
          // does not inspect its scene, or is not ready yet; message says
          // why). Never an empty scene, which is success with no objects.
          // timestamp and objects carry nothing then.
          success: "bool",
          message: "string",
          // Implementer-side capture time of this snapshot.
          timestamp: "time",
          // One record per spawned object, in the implementer's order.
          objects: {
            $type: "array",
            $items: {
              $type: "object",
              object_id: "string",
              // The asset it was spawned from.
              asset_id: "string",
              // "dynamic", "static" or "none", as spawned.
              physics: "string",
              mass: "f64",
              scale: "f64",
              position: { $type: "array", $items: "f64", $length: 3 },
              orientation: { $type: "array", $items: "f64", $length: 4 },
              linear_velocity: { $type: "array", $items: "f64", $length: 3 },
              angular_velocity: { $type: "array", $items: "f64", $length: 3 },
            },
          },
        },
      },
    ],
  },
}
