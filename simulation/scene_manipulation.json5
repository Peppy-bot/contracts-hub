              frame: { $type: "string", $optional: true, $description: "The frame of the record's values, as transforms names frames; absent, world." },
              timestamp: { $type: "time", $optional: true, $description: "The time on the clock of transforms at which the values hold. A command leaves it out for the latest time; a report leaves it out for values that hold at every time." },
              position: { $type: "array", $items: "f64", $length: 3, $description: "x, y, z (m)." },
              orientation: { $type: "array", $items: "f64", $length: 4, $optional: true, $description: "A unit quaternion [x, y, z, w], or absent for none." },
            },
