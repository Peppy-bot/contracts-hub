// Editing the world of a simulation engine while it runs: listing the assets
// the engine can place, loading a scene, spawning, moving, pushing and
// removing objects, and relocating a robot. Any engine that keeps a scene
// graph can implement it; a commander only needs the contract, not the
// engine.
//
// Asset ids come from get_assets_list and carry their kind as a prefix
// ("scene/<id>" or "object/<id>"). Object ids are minted by the implementer
// on spawn, and by the implementer that places the objects of a loaded
// scene as objects of the same set. get_objects_list reports what stands in
// the scene and where, for a caller that sets the world up and checks its
// setup; the engine's object_state contract reports the same objects with
// their velocities, as a stream, for evaluation. Robot names come from
// get_robots_list. Positions are world-frame x, y, z in meters, headings are
// a yaw in radians about the world's +z, orientations are unit quaternions
// [x, y, z, w] in the world frame, forces are world-frame newtons, masses
// are kilograms.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "scene_manipulation",
    tag: "v1",
  },
  interfaces: {
    services: [
      {
        // The catalogue of placeable assets, as a JSON array in assets_json.
        // Every entry carries at least asset_id, display_name, description,
        // kind ("scene" or "object") and category; implementers may add
        // engine-specific fields. Each request field narrows the list; a
        // field that is absent, or sent empty, narrows nothing, so a request
        // without fields lists the whole catalogue.
        name: "get_assets_list",
        request_message_format: {
          // "scene" or "object". Another value is refused.
          kind: { $type: "string", $optional: true },
          // A category get_asset_categories reports. An unknown one lists
          // nothing.
          category: { $type: "string", $optional: true },
          // Text an entry's asset_id, display_name or description must
          // contain, compared without regard to case.
          query: { $type: "string", $optional: true },
        },
        response_message_format: {
          success: "bool",
          message: "string",
          assets_json: "string",
        },
      },
      {
        // The categories of the catalogue and how many assets each one
        // holds, so a caller filters get_assets_list before it lists.
        name: "get_asset_categories",
        response_message_format: {
          success: "bool",
          message: "string",
          categories: {
            $type: "array",
            $items: {
              $type: "object",
              // "scene" or "object".
              kind: "string",
              category: "string",
              // Assets of this kind in this category.
              count: "u32",
            },
          },
        },
      },
      {
        // What stands in the scene and where, for a caller that sets the
        // world up and checks its setup: every object the implementer
        // tracks, spawned by a caller or placed by the loaded scene, with
        // its pose as of `timestamp`. A dynamic object can move after that
        // instant. The order is the implementer's object order.
        name: "get_objects_list",
        request_message_format: {
          // "spawned" lists the objects a caller spawned, "scene" the
          // objects the loaded scene placed. Absent, or empty, lists both.
          // Another value is refused. An implementer that tracks no
          // scene-placed object as an object answers "scene" with an empty
          // list.
          source: { $type: "string", $optional: true },
          // A category get_asset_categories reports. Absent, or empty,
          // lists every category.
          category: { $type: "string", $optional: true },
        },
        response_message_format: {
          success: "bool",
          message: "string",
          // Capture time of the poses, on the implementer's clock.
          timestamp: "time",
          objects: {
            $type: "array",
            $items: {
              $type: "object",
              // The id move_object, remove_object and apply_force take.
              object_id: "string",
              // The "object/<id>" asset the object is an instance of.
              asset_id: "string",
              // The asset's category, as get_asset_categories reports it.
              category: "string",
              // "spawned" or "scene".
              source: "string",
              // "dynamic", "static" or "none", as spawn_object takes it.
              physics: "string",
              // Mass (kg).
              mass: "f64",
              // Uniform scale; 1 = as authored.
              scale: "f64",
              // Where the object's origin stands: x, y, z (m).
              position: { $type: "array", $items: "f64", $length: 3 },
              // How the object is turned: a unit quaternion [x, y, z, w].
              orientation: { $type: "array", $items: "f64", $length: 4 },
            },
          },
        },
      },
      {
        // The scene that is loaded now: the "scene/<id>" asset load_scene
        // took, or the implementer's default scene after clear_scene, and
        // the scale it stands at. An implementer that opens on no scene
        // answers an empty asset_id until a load.
        name: "get_scene",
        response_message_format: {
          success: "bool",
          message: "string",
          asset_id: "string",
          // Uniform scale of the scene; 1 = as authored.
          scale: "f64",
        },
      },
      {
        // The robots standing in the world, one entry each, so a commander
        // lists what it may address and a test counts what the world holds.
        name: "get_robots_list",
        response_message_format: {
          success: "bool",
          message: "string",
          robots: {
            $type: "array",
            $items: {
              $type: "object",
              // The instance name that addresses this robot, which is what
              // move_robot takes.
              robot: "string",
              // The id of the engine's robot catalogue it stands as.
              model: "string",
              // Where its base stands: x, y, z in metres.
              position: { $type: "array", $items: "f64", $length: 3 },
              // Which way the base faces: rotation about the world's +z in
              // radians.
              yaw: "f64",
              // True for a robot that joined over simulation_robot, false
              // for a robot the world stands itself, which leaves only with
              // the simulation.
              attached: "bool",
            },
          },
        },
      },
    ],
    actions: [
      {
        // Replace the current scene with the asset named by asset_id, which
        // must be of kind "scene". Spawned objects are removed first. A load
        // that arrives while another one runs may replace it: the replaced
        // goal then ends as cancelled, and its message names the load that
        // replaced it.
        name: "load_scene",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            // Uniform scale applied to the scene; 1 = as authored.
            scale: "f64",
          },
        },
        // One message when the goal is accepted, then one whenever a field
        // below changes, a few changes of a short period in one message,
        // and none while nothing changes: silence means the goal makes no
        // progress. The stream ends with the goal.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            // Bytes of the scene's asset files received so far; 0 for an
            // engine that fetches nothing.
            bytes_fetched: "u64",
            // Files of the scene that are ready: found in the engine's
            // cache or received whole.
            files_ready: "u64",
            // True once every file is ready and the engine builds the
            // scene.
            building: "bool",
          },
        },
        result_service: {
          response_message_format: {
            // False when the scene was refused or failed to load; message
            // says why.
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Remove every spawned object and restore the default scene.
        name: "clear_scene",
        goal_service: {},
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Place one instance of an "object" asset and report its new id.
        name: "spawn_object",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // Rotation about the world's +z in radians; 0 = as authored.
            // Ignored when orientation is present.
            yaw: "f64",
            // When present, the object's orientation in the world frame, a
            // unit quaternion [x, y, z, w], in place of yaw. A quaternion
            // whose length differs from 1 by more than 0.001 is refused;
            // inside that, the implementer normalises it.
            orientation: { $type: "array", $items: "f64", $length: 4, $optional: true },
            // Uniform scale; 1 = as authored.
            scale: "f64",
            // "dynamic" (simulated, falls and collides), "static" (collides,
            // never moves) or "none" (visual only).
            physics: "string",
            // Mass (kg) of a dynamic object; ignored otherwise.
            mass: "f64",
          },
        },
        // One message when the goal is accepted, then one whenever a field
        // below changes, a few changes of a short period in one message,
        // and none while nothing changes: silence means the goal makes no
        // progress. The stream ends with the goal.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            // Bytes of the object's asset files received so far; 0 for an
            // engine that fetches nothing.
            bytes_fetched: "u64",
            // Files of the object that are ready: found in the engine's
            // cache or received whole.
            files_ready: "u64",
            // True once every file is ready and the engine builds the
            // object.
            building: "bool",
          },
        },
        result_service: {
          response_message_format: {
            // False when the asset is unknown, the arguments are invalid or
            // the spawn failed; message says why.
            success: "bool",
            message: "string",
            // The implementer-minted id of the new object; empty on failure.
            object_id: "string",
          },
        },
      },
      {
        // Teleport an object to a new position, zeroing its velocity. It
        // keeps its orientation unless the goal carries one.
        name: "move_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // When present, the object's new orientation in the world
            // frame, a unit quaternion [x, y, z, w], validated as
            // spawn_object validates it. Absent keeps the orientation the
            // object has.
            orientation: { $type: "array", $items: "f64", $length: 4, $optional: true },
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Delete an object.
        name: "remove_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Push a dynamic object with a constant world-frame force for
        // duration_s seconds. The goal completes once the push is scheduled,
        // not when it ends.
        name: "apply_force",
        goal_service: {
          request_message_format: {
            object_id: "string",
            force: { $type: "array", $items: "f64", $length: 3 },
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Relocate one robot's base to a new world-frame position and
        // heading, keeping its joint configuration. `robot` is the instance
        // name the engine reports in get_robots_list; an engine hosting
        // several moves that one and leaves the rest standing. A caller that
        // only translates passes back the yaw get_robots_list reports.
        name: "move_robot",
        goal_service: {
          request_message_format: {
            robot: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // Which way the base faces once moved: rotation about the
            // world's +z in radians.
            yaw: "f64",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
    ],
  },
}
