// Editing the world of a simulation engine while it runs: listing the assets
// the engine can place, loading a scene, spawning, moving, pushing and
// removing objects, and relocating a robot. Any engine that keeps a scene
// graph can implement it; a commander only needs the contract, not the
// engine.
//
// Asset ids come from get_assets_list and carry their kind as a prefix
// ("scene/<id>" or "object/<id>"). Object ids are minted by the implementer
// on spawn. What is spawned, and where it stands, is not read here: the
// engine's object_state contract reports it, so a commander that lists
// objects binds both contracts to the same engine. Robot names come from
// get_robots_list. Positions are world-frame x, y, z in meters, forces are
// world-frame newtons, masses are kilograms.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "scene_manipulation",
    tag: "v1",
  },
  interfaces: {
    services: [
      {
        // The catalogue of placeable assets, as a JSON array in assets_json.
        // Every entry carries at least asset_id, display_name, kind ("scene" or
        // "object") and category; implementers may add engine-specific
        // fields.
        name: "get_assets_list",
        response_message_format: {
          success: "bool",
          message: "string",
          assets_json: "string",
        },
      },
      {
        // The robots standing in the world, one entry per robot: the name a
        // scene command addresses it by, the id of the engine's robot
        // catalogue it stands as, where its base stands, and whether it
        // holds a seat through simulation_robot or the engine stands it on
        // its own. A commander lists what it may address and a test counts
        // what the world holds.
        name: "get_robots_list",
        response_message_format: {
          // False when the engine cannot list its robots yet; message says
          // why. Never an empty world, which is success with no robots.
          success: "bool",
          message: "string",
          robots: {
            $type: "array",
            $items: {
              $type: "object",
              robot: "string",
              model: "string",
              // World-frame x, y, z of the robot's base, in meters.
              position: { $type: "array", $items: "f64", $length: 3 },
              // True for a robot seated through simulation_robot, false for
              // one the engine stands on its own.
              attached: "bool",
            },
          },
        },
      },
    ],
    actions: [
      {
        // Replace the current scene with the asset named by asset_id, which
        // must be of kind "scene". Spawned objects are removed first.
        name: "load_scene",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            // Uniform scale applied to the scene; 1 = as authored.
            scale: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the scene was refused or failed to load; message
            // says why.
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Remove every spawned object and restore the default scene.
        name: "clear_scene",
        goal_service: {},
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Place one instance of an "object" asset and report its new id.
        name: "spawn_object",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // Uniform scale; 1 = as authored.
            scale: "f64",
            // "dynamic" (simulated, falls and collides), "static" (collides,
            // never moves) or "none" (visual only).
            physics: "string",
            // Mass (kg) of a dynamic object; ignored otherwise.
            mass: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the asset is unknown, the arguments are invalid or
            // the spawn failed; message says why.
            success: "bool",
            message: "string",
            // The implementer-minted id of the new object; empty on failure.
            object_id: "string",
          },
        },
      },
      {
        // Teleport a spawned object to a new position, keeping its
        // orientation and zeroing its velocity.
        name: "move_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Delete a spawned object.
        name: "remove_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Push a dynamic object with a constant world-frame force for
        // duration_s seconds. The goal completes once the push is scheduled,
        // not when it ends.
        name: "apply_force",
        goal_service: {
          request_message_format: {
            object_id: "string",
            force: { $type: "array", $items: "f64", $length: 3 },
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Relocate one robot's base to a new world-frame position, keeping
        // its joint configuration. `robot` is the name the engine reports
        // in get_robots_list; an engine hosting several moves that one and
        // leaves the rest standing.
        name: "move_robot",
        goal_service: {
          request_message_format: {
            robot: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
    ],
  },
}
