// Editing the world of a simulation engine while it runs: listing the assets
// the engine can place, loading a scene, spawning, moving, pushing and
// removing objects, and relocating a robot. Any engine that keeps a scene
// graph can implement it; a commander only needs the contract, not the
// engine.
//
// Asset ids come from get_assets_list and carry their kind as a prefix
// ("scene/<id>" or "object/<id>"). Object ids are minted by the implementer
// on spawn, and by the implementer that places the objects of a loaded
// scene as objects of the same set. get_objects_list reports what stands in
// the scene and where, and get_object reports one object at one instant,
// its landmarks in the world frame and its state, for a caller that sets
// the world up, checks its setup and checks an event it asked for; the
// engine's object_state contract reports the same objects with their
// velocities, as a stream, for evaluation. Robot names come from
// get_robots_list. Positions are world-frame x, y, z in meters, headings are
// a yaw in radians about the world's +z, orientations are unit quaternions
// [x, y, z, w] in the world frame, forces are world-frame newtons, masses
// are kilograms.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "scene_manipulation",
    tag: "v1",
  },
  interfaces: {
    services: [
      {
        // The catalogue of placeable assets, as a JSON array in assets_json.
        // Every entry carries at least asset_id, display_name, description,
        // kind ("scene" or "object") and category; implementers may add
        // engine-specific fields. Each request field narrows the list; a
        // field that is absent, or sent empty, narrows nothing, so a request
        // without fields lists the whole catalogue.
        name: "get_assets_list",
        request_message_format: {
          // "scene" or "object". Another value is refused.
          kind: { $type: "string", $optional: true },
          // A category get_asset_categories reports. An unknown one lists
          // nothing.
          category: { $type: "string", $optional: true },
          // Text an entry's asset_id, display_name or description must
          // contain, compared without regard to case.
          query: { $type: "string", $optional: true },
        },
        response_message_format: {
          success: "bool",
          message: "string",
          assets_json: "string",
        },
      },
      {
        // The categories of the catalogue and how many assets each one
        // holds, so a caller filters get_assets_list before it lists.
        name: "get_asset_categories",
        response_message_format: {
          success: "bool",
          message: "string",
          categories: {
            $type: "array",
            $items: {
              $type: "object",
              // "scene" or "object".
              kind: "string",
              category: "string",
              // Assets of this kind in this category.
              count: "u32",
            },
          },
        },
      },
      {
        // What stands in the scene and where, for a caller that sets the
        // world up and checks its setup: every object the implementer
        // tracks, spawned by a caller or placed by the loaded scene, with
        // its pose as of `timestamp`. A dynamic object can move after that
        // instant. The order is the implementer's object order.
        name: "get_objects_list",
        request_message_format: {
          // "spawned" lists the objects a caller spawned, "scene" the
          // objects the loaded scene placed. Absent, or empty, lists both.
          // Another value is refused. An implementer that tracks no
          // scene-placed object as an object answers "scene" with an empty
          // list.
          source: { $type: "string", $optional: true },
          // A category get_asset_categories reports. Absent, or empty,
          // lists every category.
          category: { $type: "string", $optional: true },
        },
        response_message_format: {
          success: "bool",
          message: "string",
          // Capture time of the poses, on the implementer's clock.
          timestamp: "time",
          objects: {
            $type: "array",
            $items: {
              $type: "object",
              // The id move_object, remove_object and apply_force take.
              object_id: "string",
              // The "object/<id>" asset the object is an instance of.
              asset_id: "string",
              // The asset's category, as get_asset_categories reports it.
              category: "string",
              // "spawned" or "scene".
              source: "string",
              // "dynamic", "static" or "none", as spawn_object takes it.
              physics: "string",
              // Mass (kg).
              mass: "f64",
              // Uniform scale; 1 = as authored.
              scale: "f64",
              // Where the object's origin stands: x, y, z (m).
              position: { $type: "array", $items: "f64", $length: 3 },
              // How the object is turned: a unit quaternion [x, y, z, w].
              orientation: { $type: "array", $items: "f64", $length: 4 },
            },
          },
        },
      },
      {
        // One object at one instant, for a caller that sets the world up,
        // checks its setup and checks an event it asked for: its pose, its
        // landmarks in the world frame and its state, all as of
        // `timestamp`. Each state field is present only for an object whose
        // asset simulates it. An object_id that names no object is refused.
        name: "get_object",
        request_message_format: {
          // The id get_objects_list gives.
          object_id: "string",
        },
        response_message_format: {
          success: "bool",
          message: "string",
          // The simulated instant of the pose, the landmarks and the
          // state, on the implementer's clock.
          timestamp: "time",
          object_id: "string",
          // The "object/<id>" asset the object is an instance of.
          asset_id: "string",
          // Where the object's origin stands: x, y, z (m), as
          // get_objects_list gives it.
          position: { $type: "array", $items: "f64", $length: 3 },
          // How the object is turned: a unit quaternion [x, y, z, w].
          orientation: { $type: "array", $items: "f64", $length: 4 },
          // Uniform scale; 1 = as authored.
          scale: "f64",
          // The working parts of the object that its asset declares, in
          // the world frame: each at the pose its body has now and sized by
          // the scale. Empty for an asset that declares none.
          landmarks: {
            $type: "array",
            $items: {
              $type: "object",
              // Unique in the asset, such as "base" or "zone_front_left".
              name: "string",
              // "base" (the face the object rests on), "support" (a face
              // that things rest on or in, such as the inside bottom of a
              // pan or a cooker zone), "opening" (the mouth of a
              // container), "grip" (a handle), "inlet" or "outlet" (where a
              // belt takes or gives things) or "tip" (the end of a spout or
              // a tool).
              use: "string",
              // "point", "disc", "rectangle" or "bar".
              shape: "string",
              // The body of the object the landmark is fixed to; "root"
              // for the object's root body.
              body: "string",
              // Its centre: x, y, z (m).
              centre: { $type: "array", $items: "f64", $length: 3 },
              // The unit vector it faces out of the object along: down for
              // a base, up for a support, out of the mouth for an opening,
              // the side a hand comes from for a grip, up from the belt for
              // an inlet or an outlet, the way a tip points.
              normal: { $type: "array", $items: "f64", $length: 3 },
              // A unit vector at a right angle to normal, along which the
              // first side of size lies: the first side of a rectangle, the
              // length of a bar, the direction of travel at an inlet or an
              // outlet; any such vector for a disc or a point.
              axis: { $type: "array", $items: "f64", $length: 3 },
              // Along axis, then across it (m): a disc's diameter twice, a
              // bar's length and thickness, [0, 0] for a point.
              size: { $type: "array", $items: "f64", $length: 2 },
            },
          },
          // The world-frame box of every colliding geometry of the object
          // now: its body, its loose pieces and its contents. Its lowest
          // x, y, z and its highest x, y, z (m). Absent for an object with
          // no colliding geometry.
          bounds: {
            $type: "object",
            $optional: true,
            min: { $type: "array", $items: "f64", $length: 3 },
            max: { $type: "array", $items: "f64", $length: 3 },
          },
          // For an asset with pieces that break off: how many have broken
          // off, of how many. The object is broken when pieces_off is above
          // 0.
          breakage: {
            $type: "object",
            $optional: true,
            pieces_off: "u32",
            pieces_total: "u32",
          },
          // For an asset that holds a liquid: one entry for each phase of
          // the liquid.
          contents: {
            $type: "array",
            $optional: true,
            $items: {
              $type: "object",
              // The phase's id, such as "yolk".
              phase: "string",
              // Its mass now (kg). It drops as water boils off.
              mass: "f64",
              // The share of that mass inside the shell, 0 to 1; 0 for an
              // object without a shell.
              in_shell: "f64",
              // The centre of that mass: x, y, z (m).
              centre: { $type: "array", $items: "f64", $length: 3 },
              // The radius around the centre, in the horizontal plane,
              // that holds 95 % of that mass (m).
              spread: "f64",
              // What the phase rests on: the object itself while its shell
              // holds most of the phase, else what a ray straight down from
              // the centre meets first past the whole object, named as
              // scene_view's locate_in_view names a thing.
              below: {
                $type: "object",
                // "object", "robot", "floor" or "backdrop"; "" when the ray
                // meets nothing.
                kind: "string",
                // For an object: its object_id and its "object/<id>" asset.
                object_id: "string",
                asset_id: "string",
                // For a robot: its name, and the part the ray meets, an arm
                // or a gripper under the name the robot's limbs answer to,
                // or "body" for the rest of the robot.
                robot: "string",
                part: "string",
                // For "backdrop": the name the scene gives the piece.
                name: "string",
              },
              // How far the phase has set and browned, each a mean over its
              // mass, 0 to 1.
              set: "f64",
              browned: "f64",
              // Its temperature, the mean over its mass (degrees C).
              temperature_c: "f64",
            },
          },
          // For each phase of the contents that a membrane holds, such as
          // a yolk: whether the membrane is whole.
          membranes: {
            $type: "array",
            $optional: true,
            $items: {
              $type: "object",
              phase: "string",
              whole: "bool",
            },
          },
          // For an asset with a part that crushes, one entry for each such
          // part.
          crush: {
            $type: "array",
            $optional: true,
            $items: {
              $type: "object",
              // The body that crushes.
              body: "string",
              // True once its load passed the load that crushes it. What
              // is crushed stays crushed.
              crushed: "bool",
              // How far its rest point moved from where it started: metres
              // along a slide, radians about a hinge.
              crushed_by: "f64",
            },
          },
          // For an object that takes and gives heat: its temperature now.
          heat: {
            $type: "object",
            $optional: true,
            // Degrees C.
            temperature_c: "f64",
          },
          // For an object with heaters, one entry for each heater: the
          // temperature of what it heats directly, the glass of an
          // induction zone or the air of an oven.
          heaters: {
            $type: "array",
            $optional: true,
            $items: {
              $type: "object",
              // The heater's name, such as "zone_front_left" or "oven".
              name: "string",
              // Degrees C.
              temperature_c: "f64",
            },
          },
        },
      },
      {
        // The scene that is loaded now: the "scene/<id>" asset load_scene
        // took, or the implementer's default scene after clear_scene, and
        // the scale it stands at. An implementer that opens on no scene
        // answers an empty asset_id until a load.
        name: "get_scene",
        response_message_format: {
          success: "bool",
          message: "string",
          asset_id: "string",
          // Uniform scale of the scene; 1 = as authored.
          scale: "f64",
        },
      },
      {
        // The robots standing in the world, one entry each, so a commander
        // lists what it may address and a test counts what the world holds.
        name: "get_robots_list",
        response_message_format: {
          success: "bool",
          message: "string",
          robots: {
            $type: "array",
            $items: {
              $type: "object",
              // The instance name that addresses this robot, which is what
              // move_robot takes.
              robot: "string",
              // The id of the engine's robot catalogue it stands as.
              model: "string",
              // Where its base stands: x, y, z in metres.
              position: { $type: "array", $items: "f64", $length: 3 },
              // Which way the base faces: rotation about the world's +z in
              // radians.
              yaw: "f64",
              // True for a robot that joined over simulation_robot, false
              // for a robot the world stands itself, which leaves only with
              // the simulation.
              attached: "bool",
            },
          },
        },
      },
    ],
    actions: [
      {
        // Replace the current scene with the asset named by asset_id, which
        // must be of kind "scene". Spawned objects are removed first. A load
        // that arrives while another one runs may replace it: the replaced
        // goal then ends as cancelled, and its message names the load that
        // replaced it.
        name: "load_scene",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            // Uniform scale applied to the scene; 1 = as authored.
            scale: "f64",
          },
        },
        // One message when the goal is accepted, then one whenever a field
        // below changes, a few changes of a short period in one message,
        // and none while nothing changes: silence means the goal makes no
        // progress. The stream ends with the goal.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            // Bytes of the scene's asset files received so far; 0 for an
            // engine that fetches nothing.
            bytes_fetched: "u64",
            // Files of the scene that are ready: found in the engine's
            // cache or received whole.
            files_ready: "u64",
            // True once every file is ready and the engine builds the
            // scene.
            building: "bool",
            // Bytes of the scene's asset files that are in the engine's
            // cache: each file found there or received whole, and the bytes
            // received so far of each file in transfer, each byte counted
            // once. bytes_ready of bytes_total is the share of the fetch
            // that is done.
            bytes_ready: "u64",
            // Bytes of every asset file the scene needs, as the catalogue
            // records them; 0 for an engine that fetches nothing.
            bytes_total: "u64",
            // Bytes received per second over the last two seconds, the
            // rate of bytes_fetched; 0 once nothing arrived for two
            // seconds, and once the engine builds the scene.
            bytes_per_second: "u64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the scene was refused or failed to load; message
            // says why.
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Remove every spawned object and restore the default scene.
        name: "clear_scene",
        goal_service: {},
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Place one instance of an "object" asset and report its new id.
        name: "spawn_object",
        goal_service: {
          request_message_format: {
            asset_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // Rotation about the world's +z in radians; 0 = as authored.
            // Ignored when orientation is present.
            yaw: "f64",
            // When present, the object's orientation in the world frame, a
            // unit quaternion [x, y, z, w], in place of yaw. A quaternion
            // whose length differs from 1 by more than 0.001 is refused;
            // inside that, the implementer normalises it.
            orientation: { $type: "array", $items: "f64", $length: 4, $optional: true },
            // Uniform scale; 1 = as authored.
            scale: "f64",
            // "dynamic" (simulated, falls and collides), "static" (collides,
            // never moves) or "none" (visual only).
            physics: "string",
            // Mass (kg) of a dynamic object; ignored otherwise.
            mass: "f64",
          },
        },
        // One message when the goal is accepted, then one whenever a field
        // below changes, a few changes of a short period in one message,
        // and none while nothing changes: silence means the goal makes no
        // progress. The stream ends with the goal.
        feedback_topic: {
          qos_profile: "standard",
          message_format: {
            // Bytes of the object's asset files received so far; 0 for an
            // engine that fetches nothing.
            bytes_fetched: "u64",
            // Files of the object that are ready: found in the engine's
            // cache or received whole.
            files_ready: "u64",
            // True once every file is ready and the engine builds the
            // object.
            building: "bool",
            // Bytes of the object's asset files that are in the engine's
            // cache: each file found there or received whole, and the bytes
            // received so far of each file in transfer, each byte counted
            // once. bytes_ready of bytes_total is the share of the fetch
            // that is done.
            bytes_ready: "u64",
            // Bytes of every asset file the object needs, as the catalogue
            // records them; 0 for an engine that fetches nothing.
            bytes_total: "u64",
            // Bytes received per second over the last two seconds, the
            // rate of bytes_fetched; 0 once nothing arrived for two
            // seconds, and once the engine builds the object.
            bytes_per_second: "u64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the asset is unknown, the arguments are invalid or
            // the spawn failed; message says why.
            success: "bool",
            message: "string",
            // The implementer-minted id of the new object; empty on failure.
            object_id: "string",
          },
        },
      },
      {
        // Teleport an object to a new position, zeroing its velocity. It
        // keeps its orientation unless the goal carries one.
        name: "move_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // When present, the object's new orientation in the world
            // frame, a unit quaternion [x, y, z, w], validated as
            // spawn_object validates it. Absent keeps the orientation the
            // object has.
            orientation: { $type: "array", $items: "f64", $length: 4, $optional: true },
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Delete an object.
        name: "remove_object",
        goal_service: {
          request_message_format: {
            object_id: "string",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Push a dynamic object with a constant world-frame force for
        // duration_s seconds. The goal completes once the push is scheduled,
        // not when it ends.
        name: "apply_force",
        goal_service: {
          request_message_format: {
            object_id: "string",
            force: { $type: "array", $items: "f64", $length: 3 },
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
      {
        // Relocate one robot's base to a new world-frame position and
        // heading, keeping its joint configuration. `robot` is the instance
        // name the engine reports in get_robots_list; an engine hosting
        // several moves that one and leaves the rest standing. A caller that
        // only translates passes back the yaw get_robots_list reports.
        name: "move_robot",
        goal_service: {
          request_message_format: {
            robot: "string",
            position: { $type: "array", $items: "f64", $length: 3 },
            // Which way the base faces once moved: rotation about the
            // world's +z in radians.
            yaw: "f64",
          },
        },
        result_service: {
          response_message_format: {
            success: "bool",
            message: "string",
          },
        },
      },
    ],
  },
}
