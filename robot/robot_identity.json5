{
  peppy_schema: "contract/v1",
  manifest: {
    name: "robot_identity",
    tag: "v1",
    description: [
      "Who a robot is: the name it stands under, the model it is and the core node hosting it.",
      "A distinct contract from robot_ready: identity, not readiness, so a consumer that tells robots apart needs no readiness link and the answer holds for the robot's whole session, ready or not.",
    ],
  },
  interfaces: {
    services: [
      {
        name: "get_identity",
        description: "Give who the robot is: the name it stands under, its model and the core node hosting it. The answer holds for the whole session of the robot, ready or not.",
        response_message_format: {
          robot: { $type: "string", $description: "The name this robot stands under everywhere: the copy it runs as, or its instance id for a robot launched outside a copy. A simulation hosting the robot lists it under this name." },
          model: { $type: "string", $description: "The robot's model id, for example openarm_v2." },
          core_node: { $type: "string", $description: "The core node hosting the robot." }
        }
      }
    ]
  }
}
