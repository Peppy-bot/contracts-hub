{
  // Component-level readiness. `ready` is true once one component of a robot
  // (an arm, a gripper, a sim relay for either) is ready to serve motion,
  // false otherwise. A distinct contract from robot_ready: component
  // readiness, not robot readiness, so a robot-level consumer can never be
  // linked to a single component.
  peppy_schema: "contract/v1",
  manifest: {
    name: "component_ready",
    tag: "v1"
  },
  interfaces: {
    services: [
      {
        name: "is_ready",
        response_message_format: {
          ready: "bool"
        }
      }
    ]
  }
}
