// The whole-robot posture moves: a robot that can plan and execute a motion
// bringing every limb to a named posture. Two postures cover the operating
// loop:
// - home: the rest posture, the robot's natural pose to start from and power
//   down at. For an arm, low and close to the robot's body.
// - ready: the working posture, out in the robot's main workspace and poised
//   to take commands. For an arm, raised out in front.
// The exact joint values behind each name are the implementer's business.
// Distinct from the streamed setpoints on the *_link pairings: these are
// discrete planned moves with a result.
//
// Pose rule for the results: a result reports where each arm ended, as
// limb_state reports it, or no pose and the reason:
// - The per-arm arrays are index-aligned with arm_names. positions carries
//   3 entries per arm (x, y, z), at index i*3. orientations carries 4
//   entries per arm (quaternion x, y, z, w), at index i*4.
// - The implementer measures the pose of each arm when the move of that
//   arm ends, whatever success says. After a cancel or a stop, the pose is
//   where the arm stopped.
// - When an arm has no fresh measured pose at the end of its move, the
//   three arrays are empty and message says why. For example, the
//   implementer never measured the joints of that arm, their last
//   measurement is stale, or its move did not report its end.
//
// A grasp-point pose is the gripper's grasp point, in the robot frame,
// position in meters and orientation as a unit quaternion [x, y, z, w]. On
// a gripper whose jaws close symmetrically, it is on the jaw closing axis
// midway between the pads. The SO-101 gripper has one moving jaw, so the
// midpoint of its pads moves with the opening. Thus, the SO-101 reports a
// fixed point near its jaws.
//
// The robot frame is fixed to the robot's base: its origin is the point
// the base stands on, +X points the way the robot faces, +Y to its left
// and +Z up. It moves with the robot, and it is not a frame of the room or
// of a simulated world.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "postures",
    tag: "v1",
  },
  interfaces: {
    actions: [
      {
        name: "move_to_ready",
        goal_service: {
          request_message_format: {
            // Requested move duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // The implementer's fixed set of arm names (e.g. "left_arm"), in
            // its fixed order, per the header's pose rule.
            arm_names: { $type: "array", $items: "string" },
            // Measured grasp-point positions, 3 entries (x, y, z, m) per arm
            // in arm_names order, per the header's pose rule.
            positions: { $type: "array", $items: "f64" },
            // Measured grasp-point orientations, 4 entries (quaternion
            // x, y, z, w) per arm in arm_names order, per the header's pose
            // rule.
            orientations: { $type: "array", $items: "f64" },
          },
        },
      },
      {
        name: "move_to_home",
        goal_service: {
          request_message_format: {
            // Requested move duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // The implementer's fixed set of arm names (e.g. "left_arm"), in
            // its fixed order, per the header's pose rule.
            arm_names: { $type: "array", $items: "string" },
            // Measured grasp-point positions, 3 entries (x, y, z, m) per arm
            // in arm_names order, per the header's pose rule.
            positions: { $type: "array", $items: "f64" },
            // Measured grasp-point orientations, 4 entries (quaternion
            // x, y, z, w) per arm in arm_names order, per the header's pose
            // rule.
            orientations: { $type: "array", $items: "f64" },
          },
        },
      },
    ],
  },
}
