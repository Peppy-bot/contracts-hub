// The whole-robot posture moves: a robot that can plan and execute a motion
// bringing every limb to a named posture. Two postures cover the operating
// loop:
// - home: the rest posture, the robot's natural pose to start from and power
//   down at. For an arm, low and close to the robot's body.
// - ready: the working posture, out in the robot's main workspace and poised
//   to take commands. For an arm, raised out in front.
// The exact joint values behind each name are the implementer's business.
// Distinct from the streamed setpoints on the *_link pairings: these are
// discrete planned moves with a result.
//
// Pose rule for the results: a result reports where each arm ended, as
// limb_state reports it, or no pose and the reason:
// - Each pose is the grasp-point pose of an arm in the robot frame. The
//   header of limb_state defines the grasp point, the robot frame and the
//   slicing of the arrays.
// - The implementer measures the pose of every arm when the action ends,
//   after the moves of all its arms ended, whatever success says.
// - When an arm has no fresh measured pose then, the three arrays are
//   empty and message says why. For example, the implementer never
//   measured the joints of that arm, or their last measurement is stale.
// - After a cancel or a stop, an arm that was still moving can come to
//   rest away from the reported pose.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "postures",
    tag: "v1",
  },
  interfaces: {
    actions: [
      {
        name: "move_to_ready",
        goal_service: {
          request_message_format: {
            // Requested move duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // The implementer's fixed set of arm names (e.g. "left_arm"), in
            // its fixed order, per the header's pose rule.
            arm_names: { $type: "array", $items: "string" },
            // Measured grasp-point positions, 3 entries (x, y, z, m) per arm
            // in arm_names order, per the header's pose rule.
            positions: { $type: "array", $items: "f64" },
            // Measured grasp-point orientations, 4 entries (quaternion
            // x, y, z, w) per arm in arm_names order, per the header's pose
            // rule.
            orientations: { $type: "array", $items: "f64" },
          },
        },
      },
      {
        name: "move_to_home",
        goal_service: {
          request_message_format: {
            // Requested move duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // The implementer's fixed set of arm names (e.g. "left_arm"), in
            // its fixed order, per the header's pose rule.
            arm_names: { $type: "array", $items: "string" },
            // Measured grasp-point positions, 3 entries (x, y, z, m) per arm
            // in arm_names order, per the header's pose rule.
            positions: { $type: "array", $items: "f64" },
            // Measured grasp-point orientations, 4 entries (quaternion
            // x, y, z, w) per arm in arm_names order, per the header's pose
            // rule.
            orientations: { $type: "array", $items: "f64" },
          },
        },
      },
    ],
  },
}
