// Discrete, planned moves of one limb of a multi-arm manipulator: a
// joint-space arm move, a Cartesian arm move, and a gripper move, each
// addressed by a limb name from the implementer's fixed set of names.
// Each goal is planned and executed by the implementer and returns a result; they are distinct from the streamed
// setpoints on the joint_link / gripper_link / pose_link pairings.
//
// Every Cartesian pose, commanded or reported, is the gripper's grasp point
// (on the jaw closing axis midway between the pads), in the robot frame,
// position in meters and orientation as a unit quaternion [x, y, z, w].
//
// The robot frame is fixed to the robot's base: its origin is the point
// the base stands on, +X points the way the robot faces, +Y to its left
// and +Z up. It moves with the robot, and it is not a frame of the room or
// of a simulated world.
//
// A move runs until it ends, its caller cancels it, or the stop service
// ends every move in flight, whoever started them. check_arm_move asks
// whether a Cartesian move has a plan, and moves nothing.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "limb_motion",
    tag: "v1",
  },
  interfaces: {
    actions: [
      {
        name: "move_arm_joints",
        goal_service: {
          request_message_format: {
            // Which arm, named from the implementer's fixed set of limb
            // names (e.g. "left_arm"). An unknown name is refused in the
            // result.
            arm_name: "string",
            // Target joint positions (rad), one per joint of the arm in its
            // fixed joint order.
            joint_positions: { $type: "array", $items: "f64" },
            // Requested trajectory duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // Measured joint positions (rad) when the action ended, one per
            // joint of the arm in its fixed joint order.
            final_joint_positions: { $type: "array", $items: "f64" },
            // Wall-clock duration of the action (s).
            action_time: "f64",
          },
        },
      },
      {
        name: "move_arm",
        goal_service: {
          request_message_format: {
            // Which arm, named from the implementer's fixed set of limb
            // names (e.g. "left_arm"). An unknown name is refused in the
            // result.
            arm_name: "string",
            // Target grasp-point position, robot frame: x, y, z (m).
            position: { $type: "array", $items: "f64", $length: 3 },
            // Target grasp-point orientation, quaternion [x, y, z, w].
            orientation: { $type: "array", $items: "f64", $length: 4 },
            // Requested trajectory duration (s); floored at the implementer's
            // velocity-limit duration. 0 = fastest.
            duration_s: "f64",
            // Not every arm can meet a position and an orientation at once. An
            // arm with fewer than six actuated joints cannot generally do both,
            // and even a redundant one runs out of postures near its limits. So
            // rather than let the implementer decide how close is close enough,
            // the caller names the slack it will accept and the goal is planned
            // within it. A goal that no solution reaches inside both tolerances
            // is rejected rather than quietly approximated.
            //
            // They bound the plan, not the path taken to it, and they promise
            // nothing about where the arm finally stops. Read final_position and
            // final_orientation for that.
            //
            // Position slack (m): the Euclidean distance between the
            // commanded and planned grasp-point positions. 0 = the
            // implementer's planner default.
            plan_position_tolerance_m: "f64",
            // Orientation slack (rad): the geodesic angle between the
            // commanded and planned orientations, q and -q naming one
            // rotation. 0 = the implementer's planner default.
            plan_orientation_tolerance_rad: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // False when the move was refused, failed, or cancelled;
            // message says which.
            success: "bool",
            message: "string",
            // Measured grasp-point position when the action ended: x, y, z (m).
            final_position: { $type: "array", $items: "f64", $length: 3 },
            // Measured grasp-point orientation, quaternion [x, y, z, w].
            final_orientation: { $type: "array", $items: "f64", $length: 4 },
            // Wall-clock duration of the action (s).
            action_time: "f64",
          },
        },
      },
      {
        name: "move_gripper",
        goal_service: {
          request_message_format: {
            // Which gripper, named from the implementer's fixed set of
            // gripper names (e.g. "left_gripper"). An unknown name is
            // refused in the result.
            gripper_name: "string",
            // Target opening as a fraction of full jaw travel: 0 = closed,
            // 1 = fully open.
            opening: "f64",
            // Maximum effort toward the target (magnitude, in the gripper's
            // effort unit). 0 = no preference; the implementer's configured
            // ceiling applies.
            max_effort: "f64",
          },
        },
        result_service: {
          response_message_format: {
            // The action ends when the gripper stands still: its measured
            // opening has stopped changing after the commanded move.
            //
            // False when the move was refused, failed, or cancelled;
            // message says which. A gripper that stands still short of the
            // target did none of these, so success is true and message says
            // where it stopped.
            success: "bool",
            message: "string",
            // Measured opening fraction when the action ended: the target,
            // or the opening where an object or the effort cap stopped the
            // jaws. The caller judges a grasp from it.
            final_opening: "f64",
            // Wall-clock duration of the action (s).
            action_time: "f64",
          },
        },
      },
    ],
    services: [
      {
        // Ends every planned move in flight on this robot, whoever started
        // it: the moves of this contract and the posture moves of the same
        // implementer. Each limb holds where it is commanded, as after a
        // cancel, and each goal ends as cancelled with a message that names
        // the stop and its reason. A goal that arrives after the stop runs
        // as usual. Setpoints streamed on a pairing are not stopped.
        name: "stop",
        request_message_format: {
          // Why the moves are stopped, carried into the message of each
          // goal the stop ends. Empty is accepted.
          reason: "string",
        },
        response_message_format: {
          // False only when the stop itself could not be carried out;
          // message says why. A stop with nothing in flight succeeds.
          success: "bool",
          message: "string",
          // The limbs whose move was stopped, by their limb names; empty
          // when nothing moved.
          stopped: { $type: "array", $items: "string" },
        },
      },
      {
        // Whether a move_arm goal with these fields has a plan from where
        // the arm is commanded now, without moving it. It checks what
        // move_arm checks before it moves, and no more: it does not check
        // collisions with the robot itself or with what stands around it.
        name: "check_arm_move",
        request_message_format: {
          // The fields of the move_arm goal, with the same meaning.
          arm_name: "string",
          position: { $type: "array", $items: "f64", $length: 3 },
          orientation: { $type: "array", $items: "f64", $length: 4 },
          duration_s: "f64",
          plan_position_tolerance_m: "f64",
          plan_orientation_tolerance_rad: "f64",
        },
        response_message_format: {
          // True when a plan exists. False with the words a move_arm
          // refusal gives when none does, when the arm is unknown, or when
          // the arm is executing a move, which the check does not disturb.
          success: "bool",
          message: "string",
          // The time the move would take (s); 0 when success is false.
          duration_s: "f64",
        },
      },
    ],
  },
}
