{
  peppy_schema: "contract/v1",
  manifest: {
    name: "collision_status",
    tag: "v1",
    description: [
      "Live proximity readout of a robot whose motion authority runs a collision governor: the nearest checked pair's signed surface distance and link names, plus the governor's current disposition of the commanded motion.",
      "Emitted continuously at the implementer's readout cadence, live regardless of whether any motion is commanded.",
    ],
  },
  interfaces: {
    topics: [
      {
        name: "collision_status",
        description: "The latest proximity reading of the robot: the signed surface distance of the nearest checked pair of links, the names of the two links, and whether the governor throttles or stops the commanded motion now. link_a and link_b are the two links forming that nearest pair. throttled and stopped are the disposition of the commanded motion, mutually exclusive: throttled means it is being scaled down to hold the band, stopped means it is fully denied at the stop floor. Both false when motion is unrestricted.",
        // High-frequency stream where only the latest reading matters;
        // occasional drops are acceptable.
        qos_profile: "sensor_data",
        message_format: {
          timestamp: { $type: "time", $description: "Implementer-side capture time of this reading." },
          distance: { $type: "f64", $description: "Signed surface distance (m) of the nearest checked pair: positive is clearance, negative is penetration depth." },
          link_a: "string",
          link_b: "string",
          throttled: "bool",
          stopped: "bool",
        },
      },
    ],
  },
}
