{
  peppy_schema: "contract/v1",
  manifest: {
    name: "lidar_2d",
    tag: "v1",
    description: [
      "A planar laser range finder (a 2-D lidar): a device or a simulated sensor that streams scans, each a fan of rays measured in one plane. A sensor that measures in three dimensions implements lidar_3d, or rgbd_camera when it is a camera that measures depth per pixel.",
      "Conventions, the same for every implementer. The fields of a scan are those of ROS's LaserScan, each with its unit in its name.",
      "Sensor frame. Fixed to the sensor: +X forward, +Y left and +Z up, the scan plane its XY plane, and angles measured counterclockwise about +Z from +X. Only the sensor's own geometry is here: where the sensor sits on a robot is not the sensor's to know, and sensor_mounts gives the pose of this frame on the robot.",
      "Rays. Ray i of a scan points at min_angle_rad + i * angle_increment_rad, in the sensor frame where the sensor stood when it measured that ray, i * time_increment_s after the scan's timestamp. Its range is the distance (m) along the ray to the first surface it met. A range of 0 marks a ray that the sensor could not measure and a surface nearer than min_range_m; a sensor that cannot tell a ray that met nothing from a ray it could not measure gives 0 for both. A range of 10000 marks a ray that met nothing within max_range_m; max_range_m is below 10000, so a consumer reads every range above max_range_m as that mark. Every other range lies within min_range_m and max_range_m, and every range is a finite number. A sensor that sweeps clockwise gives its rays in rising angle, the reverse of the order it measured them: its time_increment_s is below 0, and its timestamp is the time of ray 0, the last ray it measured. Timestamps are on the clock the implementer's instance reads, the simulation clock in a simulation, and give the time of the measurement, which is earlier than its arrival at the implementer.",
    ],
  },
  interfaces: {
    topics: [
      {
        name: "scan_stream",
        description: "The scans of the sensor, as it measures them, one per sweep.",
        qos_profile: "sensor_data",
        message_format: {
          header: {
            $type: "object",
            timestamp: { $type: "time", $description: "When the sensor measured ray 0 of the scan." },
            frame_id: { $type: "u32", $description: "The capture counter of the scan, not a coordinate frame." },
          },
          min_angle_rad: { $type: "f32", $description: "The angle of the first ray (rad)." },
          angle_increment_rad: { $type: "f32", $description: "The angle between one ray and the next (rad), above 0." },
          time_increment_s: { $type: "f32", $description: "The time from one ray to the next (s): below 0 for a sensor that sweeps clockwise, and 0 for one that measures every ray at once." },
          min_range_m: { $type: "f32", $description: "The nearest range the sensor measures (m), 0 or above." },
          max_range_m: { $type: "f32", $description: "The farthest range the sensor measures (m), above min_range_m and below 10000." },
          ranges: { $type: "array", $items: "f32", $description: "The range of each ray (m), in ray order; 0 and 10000 are the two marks of the contract's description." },
          intensities: { $type: "array", $items: "f32", $description: "The intensity of each ray, in the sensor's own unit and in ray order; empty for a sensor that measures none." },
        },
      },
    ],
  },
}
