// A contract rather than an operator-node topic so the backbone names no
// operator node, which keeps the backbone <-> operator dependency graph
// acyclic.
{
  peppy_schema: "contract/v1",
  manifest: {
    name: "openarm_governor_control",
    tag: "v1",
    description: [
      "Runtime self-collision governor controls for one openarm robot: the on/off toggle, the band, and the speed caps.",
      "A latched setting: the producer publishes when the operator changes a control, and the topic retains the newest message, so a backbone that starts later reads the setting in force at once. The values stand until the next message, with no cadence and no staleness: a backbone that loses its producer keeps governing on the last setting it was given, and one that never had a producer governs on its launch parameters.",
    ],
  },
  interfaces: {
    topics: [
      {
        name: "governor_control",
        description: "The governor setting that the operator wants the backbone to govern by: the governor on or off, its distance band and its speed caps. Each message holds the whole setting, and the backbone governs by it until the next message. d_stop and d_safe are the governor band (m): full stop at/under d_stop, unthrottled at/over d_safe, linear between. Require 0 < d_stop < d_safe.",
        // Each message is a change the backbone governs by until the next
        // one, so losing one leaves the robot on a setting the operator has
        // moved away from.
        qos_profile: "reliable",
        retention: { latest: 1 },
        message_format: {
          collision_governor_enabled: { $type: "bool", $description: "Collision governor on/off. False = passthrough, no throttling." },
          d_stop: "f64",
          d_safe: "f64",
          max_ee_velocity_m_s: { $type: "f64", $description: "End-effector linear-speed cap (m/s). Require > 0." },
          max_gripper_rate_frac_s: { $type: "f64", $description: "Largest rate (opening fraction per second) an opening may be driven at. Require > 0. The gripper node and its motor own the real opening speed; this bounds the step the governor has to scan." }
        }
      }
    ]
  }
}
